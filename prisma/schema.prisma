datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  
  // Custom relations
  caregiverCats CatCaregiver[]
  activities    ActivityLog[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// MiauCare Domain models
model Cat {
  id             String           @id @default(uuid())
  name           String
  breed          String?          @default("Común Europeo")
  age            String?          @default("2 años")
  hunger         Float            @default(75)
  hygiene        Float            @default(80)
  fun            Float            @default(60)
  streak         Int              @default(7)
  weight         Float            @default(4.2)
  lastVaccine    DateTime         @default(now())
  lastDeworming  DateTime         @default(now())
  inviteCode     String           @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  caregivers     CatCaregiver[]
  activities     ActivityLog[]
  appointments   VetAppointment[]
  medicalNotes   VetNote[]
}

// Join table for co-parenting
model CatCaregiver {
  id        String   @id @default(cuid())
  catId     String
  userId    String
  role      String   @default("owner") // owner, co-parent
  createdAt DateTime @default(now())

  cat  Cat  @relation(fields: [catId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([catId, userId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  catId     String
  userId    String?
  userName  String
  action    String
  timestamp DateTime @default(now())

  cat  Cat   @relation(fields: [catId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model VetAppointment {
  id        String   @id @default(cuid())
  catId     String
  title     String
  date      DateTime
  type      String   // vaccine, checkup, treatment
  createdAt DateTime @default(now())

  cat Cat @relation(fields: [catId], references: [id], onDelete: Cascade)
}

model VetNote {
  id        String   @id @default(cuid())
  catId     String
  content   String
  createdAt DateTime @default(now())

  cat Cat @relation(fields: [catId], references: [id], onDelete: Cascade)
}
